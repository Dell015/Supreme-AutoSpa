---
import Shapes from '../components/Shapes.astro';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { photos, galleryOrder } from '../data/site';
const filters = [['all', 'All'], ['car', 'Cars'], ['suv', 'SUVs'], ['pickup', 'Pickups'], ['bike', 'Motorcycles'], ['other', 'Heavy equipment'], ['detail', 'Detailing'], ['bay', 'The bay'], ['shop', 'The shop']];
const tagName: Record<string, string> = { car: 'Car', suv: 'SUV', pickup: 'Pickup', bike: 'Scooter', other: 'Heavy equipment', detail: 'Detailing', bay: 'In the bay', shop: 'The shop' };
const items = galleryOrder.map((k, i) => {
  const p = photos[k];
  const portrait = p.h > p.w;
  const size = portrait ? 'tall' : i % 5 === 0 ? 'big' : i % 5 === 3 ? 'wide' : 'std';
  const tag = tagName[p.tags.find((t) => t !== 'bay' && t !== 'shop') ?? p.tags[0]] ?? '';
  return { k, p, size, tag };
});
const total = items.length + 1;
const count = (f: string) => f === 'all' ? total : items.filter((x) => x.p.tags.includes(f)).length + (f === 'detail' ? 1 : 0);
---
<Base title="Gallery" description="Real photos from Supreme AutoSpa in Cauayan City: SUVs, pickups, coupes and scooters in our wash bay.">
  <section class="wrap pagehead has-shapes galhead">
    <Shapes v="c" />
    <p class="ghostword" aria-hidden="true" data-slide="-0.14">Shine · Detail · Repeat</p>
    <p class="crumbs"><a href="/">Home</a> / Gallery</p>
    <h1 class="display"><span data-line>The work</span></h1>
    <p class="lead">Every photo was taken at the shop. Pick a vehicle, tap a photo, then swipe through them.</p>
    <p class="galcount"><span class="num" data-count>{total}</span><span>photos from the bay</span></p>
  </section>
  <section class="band band--tight-top">
    <div class="wrap">
      <div class="filters filters--sticky" role="group" aria-label="Filter photos">
        {filters.map(([k, l]) => (<button type="button" data-filter={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{l}<em class="num">{count(k)}</em></button>))}
      </div>
      <div class="gal" data-gallery>
        <figure class="gal__t gal__t--ba" data-tags="detail"><BeforeAfter before="engine-before" after="engine-after" label="Drag to compare the engine bay before and after washing" /><figcaption><span class="num">00</span> Engine bay, before and after</figcaption></figure>
        {items.map(({ k, p, size, tag }, i) => (
          <figure class={`gal__t gal__t--${size}`} data-tags={p.tags.join(' ')}>
            <button type="button" data-full={`/img/${p.file}.webp`} data-thumb={`/img/${p.file}-sm.webp`} data-alt={p.alt} data-caption={p.caption} data-tag={tag} aria-label={`Enlarge: ${p.caption}`}>
              <div class="ph"><Img name={k} sizes={size === 'big' || size === 'wide' ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'} /></div>
              <span class="gal__n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="gal__cap"><b>{tag}</b>{p.caption}</span>
            </button>
          </figure>
        ))}
      </div>
      <dialog class="lb" aria-label="Photo viewer">
        <div class="lb__body">
          <div class="lb__stage"><img src="" alt="" /><button type="button" class="lb__arrow lb__arrow--l" data-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" class="lb__arrow lb__arrow--r" data-next aria-label="Next photo"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button></div>
          <div class="lb__bar">
            <div class="lb__meta"><span class="lb__count num" data-count-lb></span><div><b data-tag></b><span data-cap></span></div></div>
            <div class="lb__nav"><a class="btn" href="/quote">Request a quote</a><button type="button" data-close>Close</button></div>
          </div>
          <div class="lb__thumbs" data-thumbs></div>
        </div>
      </dialog>
    </div>
  </section>
</Base>
