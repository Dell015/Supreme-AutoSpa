---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<Base title="About" description="Supreme AutoSpa is a new car care shop on Roque Menor St, Cauayan City, built around a comfortable place to wait while your vehicle is looked after.">
  <section class="wrap pagehead">
    <p class="crumbs"><a href="/">Home</a> / About</p>
    <h1 class="display"><span data-line>Car care,</span> <span data-line>in comfort</span></h1>
  </section>
  <section class="band band--stone on-stone">
    <div class="wrap about">
      <div class="about__text">
        <p class="lead" data-reveal>Supreme AutoSpa is a new car care shop in Cauayan City. We wash, detail, coat and repaint vehicles of every kind.</p>
        <p data-reveal style="--i:1">The shop is built to feel calm: copper roofs over open bays, dark cladding and timber, bamboo and volcanic stone, and a hex-light ceiling over the work area. There is a waiting area, so you can sit down while your vehicle is looked after.</p>
        <p data-reveal style="--i:2">Find us on {site.address.street}, {site.address.city}. We are open {site.hours.days}, {site.hours.label}.</p>
        <a class="btn" href="/quote">Request a quote <Arrow /></a>
      </div>
      <div class="about__photos">
        <div class="ph" style="aspect-ratio:4/3"><Img name="shop-exterior" sizes="(max-width: 900px) 100vw, 50vw" /></div>
        <div class="ph" style="aspect-ratio:16/9"><Img name="shop-entrance-side" sizes="(max-width: 900px) 100vw, 50vw" /></div>
        <div class="ph" style="aspect-ratio:4/3"><Img name="shop-evening" sizes="(max-width: 900px) 100vw, 50vw" /></div>
        <div class="about__logo"><img src="/img/logo-640.webp" width="640" height="560" alt="Supreme AutoSpa logo" loading="lazy" /></div>
      </div>
    </div>
  </section>
</Base>
