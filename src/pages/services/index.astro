---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import { groups, allServices, photos } from '../../data/site';
const side: Record<string, string[]> = {
  'car-wash': ['hilux-undercarriage-ramp', 'sample-engine-bay'],
  detailing: ['fortuner-trd-front', 'sample-interior'],
  repainting: ['bmw-4-series', 'sample-polishing'],
};
---
<Base title="Services" description={`Every service at Supreme AutoSpa in Cauayan City: car wash, detailing, coatings, PMS and repainting. What each one does and what you get. Request a quote.`}>
  <section class="wrap pagehead" data-lit style="position:relative">
    <div class="hexbg" aria-hidden="true"><i data-parallax="0.08"></i></div><div class="hexlit" aria-hidden="true"></div>
    <p class="crumbs"><a href="/">Home</a> / Services</p>
    <h1 class="display"><span data-line>What we do</span></h1>
    <p class="lead">All {allServices.length} services, what each one does and what you get from it. Any vehicle, any make.</p>
    <nav class="jump" aria-label="Jump to a group">
      {groups.map((g) => <a href={`#${g.slug}`}>{g.title}</a>)}
    </nav>
  </section>

  {groups.map((g, gi) => (
    <section class={`band ${gi % 2 === 0 ? 'band--stone on-stone' : ''}`} id={g.slug} aria-labelledby={`${g.slug}-h`}>
      <div class="wrap sv">
        <div class="sv__intro">
          <h2 class="title" id={`${g.slug}-h`} data-reveal>{g.title}</h2>
          <p class="lead" data-reveal style="--i:1">{g.lead}</p>
          <div class="sv__photos">
            {side[g.slug].map((k) => (
              <div class="ph" data-reveal>
                <Img name={k} sizes="(max-width: 900px) 100vw, 36vw" fit={photos[k].sample ? '50% 40%' : undefined} />
                {photos[k].sample && <span class="sample">Sample photo</span>}
              </div>
            ))}
          </div>
        </div>
        <div class="sv__list">
          {g.items.map((i) => (
            <article class="sv__item" id={i.id} data-reveal>
              <Icon id={i.id} class="sv__ico" />
              <h3>{i.name}</h3>
              <dl>
                <div><dt>What it does</dt><dd>{i.text}</dd></div>
                <div><dt>What you get</dt><dd>{i.benefit}</dd></div>
              </dl>
              <a class="arrow-link" href={`/quote?service=${i.id}`}>Ask for a quote <Arrow /></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="band">
    <div class="wrap" style="display:grid;gap:24px;justify-items:start">
      <h2 class="title">Not sure which one you need?</h2>
      <p class="lead">Tell us about the vehicle and what bothers you. We will point you to the right service.</p>
      <a class="btn" href="/quote">Request a quote <Arrow /></a>
    </div>
  </section>
</Base>
