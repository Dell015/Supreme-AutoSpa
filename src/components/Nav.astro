---
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];
const quoteCur = path === '/quote' ? 'page' : undefined;
const cur = (h: string) => (path === h || path.startsWith(h + '/') ? 'page' : undefined);
---
<header class="nav">
  <a class="nav__brand" href="/" aria-label={`${site.name}, home`} aria-current={path === '/' ? 'page' : undefined}><img src="/img/logo-160.webp" srcset="/img/logo-160.webp 160w, /img/logo-320.webp 320w" sizes="64px" width="160" height="140" alt="" /><span class="vh">Supreme AutoSpa</span></a>
  <nav class="nav__links" aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
  </nav>
  <a class="btn nav__cta" href="/quote" aria-current={quoteCur}><span class="long">Request a quote</span><span class="short">Quote</span></a>
  <details class="nav__menu">
    <summary aria-label="Menu">Menu</summary>
    <div class="nav__sheet">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      {links.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
      <a class="btn" href="/quote" aria-current={quoteCur}>Request a quote</a>
      <a class="nav__call" href={`tel:${site.phoneTel}`}>Call {site.phone}</a>
      <a class="nav__call" href={site.messenger} target="_blank" rel="noopener">Message us on Messenger</a>
    </div>
  </details>
</header>
